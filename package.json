{
  "name": "olivea",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "@babel/core": ">=7.29.6",
      "ajv": ">=6.14.0 <7",
      "flatted": ">=3.4.2",
      "lodash": ">=4.17.23",
      "minimatch": ">=9.0.7",
      "postcss": ">=8.5.23",
      "postcss-selector-parser": ">=7.1.6",
      "ws": ">=8.20.1",
      "yaml": ">=2.8.3",
      "sharp": ">=0.35.5",
      "browserslist": ">=4.28.7",
      "@humanfs/node": ">=0.16.8",
      "js-yaml@^3.0.0": "^3.15.2",
      "js-yaml@^4.0.0": "^4.3.2",
      "brace-expansion@>=3.0.0": ">=5.0.12",
      "source-map-js": ">=1.2.2"
    }
  },
  "scripts": {
    "assets:prepare": "node scripts/copy-pdf-worker.mjs && node scripts/generate-press-fallback.mjs",
    "postinstall": "node scripts/copy-pdf-worker.mjs && node scripts/generate-press-fallback.mjs",
    "predev": "node scripts/copy-pdf-worker.mjs && node scripts/generate-press-fallback.mjs",
    "prebuild": "node scripts/copy-pdf-worker.mjs && node scripts/generate-press-fallback.mjs",
    "dev": "next dev --hostname olivea-localhost --port 3000",
    "dev:local": "cross-env HOST=olivea-localhost PORT=3000 next dev",
    "build": "next build",
    "start": "next start",
    "start:local": "cross-env HOST=olivea-localhost PORT=3000 next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:security": "vitest run tests/security",
    "test:e2e": "playwright test",
    "analyze": "ANALYZE=true next build",
    "images:formats": "node scripts/convert-missing-formats.mjs",
    "press:web": "node scripts/press-web.mjs"
  },
  "browserslist": {
    "production": [
      "last 3 chrome versions",
      "last 3 firefox versions",
      "last 3 edge versions",
      "last 3 safari versions",
      "last 3 ios_saf versions",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.118.0",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "focus-trap-react": "^12.0.3",
    "framer-motion": "^12.43.0",
    "gray-matter": "^4.0.3",
    "gsap": "^3.15.0",
    "js-cookie": "^3.0.8",
    "lenis": "^1.3.27",
    "lucide-react": "^0.488.0",
    "negotiator": "^1.1.0",
    "next": "16.4.3",
    "next-mdx-remote": "^6.0.0",
    "pdfjs-dist": "^6.4.299",
    "punycode.js": "^2.3.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "reading-time": "^1.5.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "resend": "^4.8.0",
    "sanitize-html": "^2.18.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "16.4.3",
    "@next/mdx": "16.4.3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "fast-glob": "^3.3.3",
    "postcss": "^8.5.31",
    "rehype-autolink-headings": "^7.1.0",
    "remark-frontmatter": "^5.0.0",
    "remark-lint": "^10.0.1",
    "remark-preset-lint-consistent": "^6.0.1",
    "remark-preset-lint-markdown-style-guide": "^6.0.1",
    "remark-unwrap-images": "^4.0.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "ts-prune": "^0.10.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "webpack-bundle-analyzer": "^4.10.2"
  }
}
